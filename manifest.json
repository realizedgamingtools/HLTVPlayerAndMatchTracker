{
  "manifest_version": 3,
  "name": "Player & Match Tracker for HLTV",
  "version": "1.2.1",
  "description": "Follow Counter-Strike teams and players on HLTV. Get alerted when they play or go live, and pop the stream open.",
  "minimum_chrome_version": "102",
  "permissions": [
    "storage",
    "notifications"
  ],
  "background": {
    "service_worker": "src/background/service-worker.js"
  },
  "action": {
    "default_title": "Player & Match Tracker for HLTV",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.hltv.org/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/core/normalize.js",
        "src/core/status.js",
        "src/core/matching.js",
        "src/core/teams.js",
        "src/core/streamers.js",
        "src/core/players.js",
        "src/core/rules.js",
        "src/core/alerts.js",
        "src/core/parser.js",
        "src/core/streams.js",
        "src/content/notifier.js",
        "src/content/content.js"
      ],
      "css": [
        "src/content/toast.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hltv.org/matches/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/core/normalize.js",
        "src/core/teams.js",
        "src/core/rules.js",
        "src/core/streams.js",
        "src/content/match-page.js"
      ],
      "css": [
        "src/content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hltv.org/team/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/shared/storage.js",
        "src/core/normalize.js",
        "src/core/teams.js",
        "src/core/rules.js",
        "src/content/team-page.js"
      ],
      "css": [
        "src/content/panel.css"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://www.hltv.org/player/*"
      ],
      "js": [
        "src/shared/constants.js",
        "src/core/normalize.js",
        "src/core/streamers.js",
        "src/core/players.js",
        "src/core/rules.js",
        "src/core/teams.js",
        "src/shared/storage.js",
        "src/content/player-page.js"
      ],
      "css": [
        "src/content/panel.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/brand48.png"
      ],
      "matches": [
        "https://www.hltv.org/*"
      ]
    }
  ]
}
